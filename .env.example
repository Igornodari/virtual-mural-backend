# ─── Aplicação ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Banco de Dados ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=virtual_mural
# Em desenvolvimento local pode usar true para sync automático
# Em PRODUÇÃO (Railway) deve ser false — migrations rodam automaticamente
DB_SYNC=false

# ─── AWS Cognito ─────────────────────────────────────────────────────────────
AWS_REGION=sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=virtual_mural_queue
RABBITMQ_DLX_EXCHANGE=virtual_mural_dlx
RABBITMQ_DLQ_QUEUE=virtual_mural_dlq

# ─── AWS SNS ─────────────────────────────────────────────────────────────────
SNS_CONDOMINIUM_TOPIC_ARN=

# ─── AWS SES ─────────────────────────────────────────────────────────────────
SES_FROM_EMAIL=noreply@virtual-mural.com

# ─── CORS ────────────────────────────────────────────────────────────────────
# Em produção, usar a URL real do frontend. Ex: https://app.virtual-mural.com
CORS_ORIGIN=http://localhost:4200

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Chaves de TESTE: sk_test_... / pk_test_...
# Chaves de PRODUÇÃO: sk_live_... / pk_live_...
# NUNCA commitar chaves reais neste arquivo
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
PAYMENT_GATEWAY_PROVIDER=stripe

# ─── Stripe Connect ──────────────────────────────────────────────────────────
STRIPE_CONNECT_RETURN_URL=http://localhost:4200/mural/provider?stripe_connect=success
STRIPE_CONNECT_REFRESH_URL=http://localhost:4200/mural/provider?stripe_connect=refresh
PLATFORM_FEE_PERCENT=5

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# OBRIGATÓRIO para push notifications funcionarem em produção
# Gerar com: npx web-push generate-vapid-keys
# NUNCA commitar as chaves reais — configurar nas variáveis do Railway
VAPID_SUBJECT=mailto:admin@virtual-mural.com
VAPID_PUBLIC_KEY=  # Cole aqui apenas para .env local (nunca commitar)
VAPID_PRIVATE_KEY= # Cole aqui apenas para .env local (nunca commitar)

# ─── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=warn
